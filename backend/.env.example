NODE_ENV=development
PORT=3001

# compose.dev.yml exposes Postgres on 5433
DATABASE_URL=postgresql://forkan:forkan@localhost:5433/forkan

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (Refresh tokens are opaque random values stored hashed in the database.)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars

# Public origin of the app; the frontend proxies /api to this backend.
FRONTEND_URL=http://localhost:3000
GOTENBERG_URL=http://localhost:3002

# v1 serves one school, looked up by slug at login
SCHOOL_SLUG=forkane
# Cron jobs (monthly charges). Set to false to run the API without pg-boss.
JOBS_ENABLED=true
# Same value as REVALIDATE_SECRET in frontend/.env.local (public site refresh after news changes)
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Seed: first admin account (used only by `npm run db:seed`)
SEED_SCHOOL_NAME=الجمعية القرآنية بسليمان الفرقان
SEED_SCHOOL_SLUG=forkane
SEED_ADMIN_EMAIL=admin@forkane.local
SEED_ADMIN_PASSWORD=change-me-on-first-login
